# Aexyl — Railway configuration.
#
# This file configures the WEB service. The scheduled-automation tick runs as
# a SEPARATE cron service (Railway cron jobs are dedicated services that
# terminate after each run — docs.railway.com/cron-jobs), started via
# `bash cron/tick.sh` with the crontab expression `*/15 * * * *` set in
# Settings → "Cron Schedule" on that service. See cron/tick.sh for the full
# setup notes; both services must share CRON_SECRET.
{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
