# Aexyl environment — copy to .env.local (local) or set in Railway variables.
# Every variable below is read somewhere in the codebase (grep `process.env.`).

# ── Database (required) ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aexyl

# ── Clerk authentication (required) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── LLM provider (optional — first configured wins: OpenAI → Anthropic →
#    Gemini → OpenRouter; with no key the AI features fall back honestly) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AEXYL_LLM_MODEL=

# ── Local lead discovery ── Nothing to configure: the local-business
# pipeline uses free public OpenStreetMap services (Nominatim geocoding +
# Overpass category queries). Ask the copilot "find gyms in Jorhat".

# ── Email (invites & outreach; Brevo or Resend — optional) ───────────
# Brevo is used when BREVO_API_KEY is set; Resend is the fallback.
# Force one explicitly with EMAIL_PROVIDER=brevo | resend.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_PROVIDER=
# Sender address — for Brevo, the sender must be verified in the Brevo dashboard.
EMAIL_FROM=Aexyl <onboarding@resend.dev>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduled automation (cron) ────────────────────────────────────────
# Shared secret for GET /api/cron/tick. The Railway cron service sends it as
# `Authorization: Bearer ${CRON_SECRET}`; the web service uses it to verify.
# Generate locally with: openssl rand -hex 32
CRON_SECRET=

# ── Cron service only (Railway cron container, not the web service) ────
# URL of the web service the tick should hit, e.g. https://aexyl.up.railway.app
AEXYL_WEB_URL=
